{
  "name": "ps-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:telephone": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "serveur:local": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "db:generer": "drizzle-kit generate",
    "db:migrer": "drizzle-kit migrate",
    "db:convertir-postgres": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mysql-vers-postgres.mts",
    "admin:creer": "node scripts/creer-administrateur.mts",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "sql:utilisateur": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generer-sql-utilisateur.mts",
    "sauvegarde:exporter": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sauvegarde.mts exporter",
    "sauvegarde:importer": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sauvegarde.mts importer"
  },
  "dependencies": {
    "better-auth": "^1.7.23",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
