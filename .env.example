# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais commiter .env.local.

# Base PostgreSQL du client, compte de l'APPLICATION (lit et écrit les lignes, ne change pas le schéma) :
# postgres://ps_time_app:mot_de_passe@hote:5432/ps_time
# Serveur de base distant : ajouter ?sslmode=require. Caractères spéciaux du mot de passe encodés (%40 pour @...).
DATABASE_URL=

# Même base, compte PROPRIÉTAIRE des tables : seulement pour npm run db:migrer (jamais utilisé par l'application).
DATABASE_URL_MIGRATIONS=

# Facultatif : connexions simultanées de l'application à la base (10 par défaut).
DATABASE_MAX_CONNEXIONS=

# Secret de signature des sessions et des sauvegardes : 32 octets aléatoires, différent pour chaque client.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Adresse publique de l'application chez le client, par exemple https://pointage.client.ma
BETTER_AUTH_URL=

# Facultatif : dossier des sauvegardes écrites sur le serveur (avant un import, ou par npm run sauvegarde:exporter).
# Par défaut : ./sauvegardes. Hors de tout dossier public, lisible par le seul compte du serveur.
DOSSIER_SAUVEGARDES=
