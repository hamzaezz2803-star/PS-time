# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais commiter .env.local.

# Base MySQL / MariaDB du client, au format mysql://utilisateur:mot_de_passe@hote:port/nom_base
DATABASE_URL=

# Secret de signature des sessions : 32 octets aléatoires, différent pour chaque client.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Adresse publique de l'application chez le client, par exemple https://pointage.client.ma
BETTER_AUTH_URL=
